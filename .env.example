# Copy to .env.local (development) or .env.production (server). These files are git-ignored.
# ALL variables are SERVER-SIDE ONLY. Never add the NEXT_PUBLIC_ prefix to any of them.
# Nothing from this file is ever bundled into the web app or the Android APK.

# ── Storage (our database = single source of truth for web, PWA and Android) ──
# postgres in production; file (.data/app-state.json) for local development
STORE_DRIVER=file
DATABASE_URL=postgres://fridgeops:change-me@localhost:5432/fridgeops
# DATABASE_SSL=true

# ── Data source ──────────────────────────────────────────────
# mock           — built-in simulator (default, safe)
# kitshop_shadow — real KiT Shop data is synced + forecast in the background, screens still show the simulator
#                  (admin compares real vs mock on /admin/kitshop/diagnostics). First production step.
# kitshop        — every screen shows real KiT Shop data (only after the shadow check)
DATA_SOURCE=mock
SIM_SEED=42
# the simulator clock follows the real time (default). false = frozen clock for tests
SIM_REALTIME=true

# ── KitShop (server only) ────────────────────────────────────
# Official API: POST https://api.kitshop.ru/APIService.svc/{Method}, Auth + MD5 Sign in the body.
KITSHOP_ENABLED=false
KITSHOP_API_URL=https://api.kitshop.ru/APIService.svc
KITSHOP_COMPANY_ID=
KITSHOP_LOGIN=
KITSHOP_PASSWORD=
# READ-ONLY real connectivity diagnostic (/admin/kitshop/diagnostics → REAL API TEST, npm run kitshop:diagnose).
# Allows CheckAuth / GetShops / GetShopStocks / GetSales even while KITSHOP_ENABLED=false. Never writes.
KITSHOP_REAL_DIAGNOSTICS=false
# optional: which shop the diagnostic reads stock from (default: first of our shops found in GetShops)
KITSHOP_TEST_SHOP_ID=
# Content-Type of API requests: unset/none = no header (as in the official examples, recommended); json = application/json
KITSHOP_CONTENT_TYPE=

# KiT Shop is READ ONLY: the app never changes anything in KiT Shop. Do not set false in production.
KITSHOP_READ_ONLY=true
# History sync — gentle towards KiT Shop: days of history, parallel GetSaleById (1–2), pause after each history call
KITSHOP_BACKFILL_DAYS=180
KITSHOP_BACKFILL_CONCURRENCY=1
KITSHOP_BACKFILL_DELAY_MS=300
# minutes added to KiT Shop sale times if KiT Shop reports another timezone (0 = same as APP_TIMEZONE)
KITSHOP_TIME_OFFSET_MINUTES=0
# "Что удалить из KiT Shop" Excel: the server rebuilds it itself (read only) and keeps the last file in the database
UNUSED_REPORT_AUTO=true
UNUSED_REPORT_EVERY_HOURS=24
# XP / OPS POINTS / rewards in the UI (off by default)
SHOW_REWARDS=false

# ── KitShop WRITES (load / unload / write-off) — DISABLED while KITSHOP_READ_ONLY=true — see docs/KITSHOP_WRITE_API_AUDIT.md ──
# Real writes need ALL: KITSHOP_ENABLED=true, KITSHOP_WRITE_ENABLED=true, KITSHOP_WRITE_DRY_RUN=false
# and the shop listed in KITSHOP_WRITE_SHOPS. Never list all fridges at once.
KITSHOP_WRITE_ENABLED=false
KITSHOP_WRITE_DRY_RUN=true
# comma-separated KiT Shop ShopIds allowed for real writes, e.g. 621583
KITSHOP_WRITE_SHOPS=
# test (default): only the admin REAL WRITE TEST may write live; all: every operation on allowlisted shops (Phase E)
KITSHOP_WRITE_SCOPE=test
# lower (default) | upper — case of the MD5 Sign, the diagnostics page tells which one KiT Shop accepts
KITSHOP_SIGN_CASE=lower
# seconds-scale wait for KiT Shop before an operation becomes UNKNOWN (3000–30000)
KITSHOP_WRITE_TIMEOUT_MS=10000
# delay of the built-in fake KiT Shop (mock adapter), ms
MOCK_KITSHOP_DELAY_MS=700

# ── Auth ─────────────────────────────────────────────────────
# Long random string (e.g. `openssl rand -base64 48`). Required in production.
AUTH_SECRET=change-me-to-a-long-random-string
# First administrator, created once when there are no users yet. Change the PIN after first login.
ADMIN_LOGIN=admin
ADMIN_PIN=
ADMIN_NAME=Администратор

# ── Timezone of the fridges (wall clock) ─────────────────────
APP_TIMEZONE=Asia/Almaty
