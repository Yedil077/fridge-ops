# Copy to .env.local (development) or .env.production (server). These files are git-ignored.
# ALL variables are SERVER-SIDE ONLY. Never add the NEXT_PUBLIC_ prefix to any of them.
# Nothing from this file is ever bundled into the web app or the Android APK.

# ── Storage (our database = single source of truth for web, PWA and Android) ──
# postgres in production; file (.data/app-state.json) for local development
STORE_DRIVER=file
DATABASE_URL=postgres://fridgeops:change-me@localhost:5432/fridgeops
# DATABASE_SSL=true

# ── Data source ──────────────────────────────────────────────
# mock    — built-in simulator (default, safe)
# kitshop — read-only KitShop adapter (requires confirmed API docs)
DATA_SOURCE=mock
SIM_SEED=42
# the simulator clock follows the real time (default). false = frozen clock for tests
SIM_REALTIME=true

# ── KitShop (server only) ────────────────────────────────────
# Official API: POST https://api.kitshop.ru/APIService.svc/{Method}, Auth + MD5 Sign in the body.
KITSHOP_ENABLED=false
KITSHOP_API_URL=https://api.kitshop.ru/APIService.svc
KITSHOP_COMPANY_ID=
KITSHOP_LOGIN=
KITSHOP_PASSWORD=

# ── KitShop WRITES (load / unload / write-off) — see docs/KITSHOP_WRITE_API_AUDIT.md ──
# Real writes need ALL: KITSHOP_ENABLED=true, KITSHOP_WRITE_ENABLED=true, KITSHOP_WRITE_DRY_RUN=false
# and the shop listed in KITSHOP_WRITE_SHOPS. Never list all fridges at once.
KITSHOP_WRITE_ENABLED=false
KITSHOP_WRITE_DRY_RUN=true
# comma-separated KiT Shop ShopIds allowed for real writes, e.g. 621583
KITSHOP_WRITE_SHOPS=
# seconds-scale wait for KiT Shop before an operation becomes UNKNOWN (3000–30000)
KITSHOP_WRITE_TIMEOUT_MS=10000
# set true only after Phase D proved that MakeFillUp.Notes is returned by GetFillUps
KITSHOP_NOTES_VERIFIED=false
# delay of the built-in fake KiT Shop (mock adapter), ms
MOCK_KITSHOP_DELAY_MS=700

# ── Auth ─────────────────────────────────────────────────────
# Long random string (e.g. `openssl rand -base64 48`). Required in production.
AUTH_SECRET=change-me-to-a-long-random-string
# First administrator, created once when there are no users yet. Change the PIN after first login.
ADMIN_LOGIN=admin
ADMIN_PIN=
ADMIN_NAME=Администратор

# ── Timezone of the fridges (wall clock) ─────────────────────
APP_TIMEZONE=Asia/Almaty
