# Copy to .env.local (development) or .env.production (server). These files are git-ignored.
# ALL variables are SERVER-SIDE ONLY. Never add the NEXT_PUBLIC_ prefix to any of them.
# Nothing from this file is ever bundled into the web app or the Android APK.

# ── Storage (our database = single source of truth for web, PWA and Android) ──
# postgres in production; file (.data/app-state.json) for local development
STORE_DRIVER=file
DATABASE_URL=postgres://fridgeops:change-me@localhost:5432/fridgeops
# DATABASE_SSL=true

# ── Data source ──────────────────────────────────────────────
# mock    — built-in simulator (default, safe)
# kitshop — read-only KitShop adapter (requires confirmed API docs)
DATA_SOURCE=mock
SIM_SEED=42
# the simulator clock follows the real time (default). false = frozen clock for tests
SIM_REALTIME=true

# ── KitShop (READ-ONLY, server only) ─────────────────────────
KITSHOP_ENABLED=false
KITSHOP_API_URL=
KITSHOP_COMPANY_ID=
KITSHOP_LOGIN=
KITSHOP_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────
# Long random string (e.g. `openssl rand -base64 48`). Required in production.
AUTH_SECRET=change-me-to-a-long-random-string
# First administrator, created once when there are no users yet. Change the PIN after first login.
ADMIN_LOGIN=admin
ADMIN_PIN=
ADMIN_NAME=Администратор

# ── Timezone of the fridges (wall clock) ─────────────────────
APP_TIMEZONE=Asia/Almaty
