# Copy to ../.env.production ON THE SERVER. Never commit the real file.
DOMAIN=ops.example.kz
POSTGRES_PASSWORD=generate-a-long-random-password

NODE_ENV=production
AUTH_SECRET=generate-with-openssl-rand-base64-48
APP_TIMEZONE=Asia/Almaty

# first administrator (created once, then change the PIN in Настройки)
ADMIN_LOGIN=admin
ADMIN_PIN=
ADMIN_NAME=Администратор

# data source: mock (pilot on the simulator) or kitshop (after API docs are confirmed)
DATA_SOURCE=mock
SIM_REALTIME=true

# KitShop — READ ONLY, server side only
KITSHOP_ENABLED=false
KITSHOP_API_URL=
KITSHOP_COMPANY_ID=
KITSHOP_LOGIN=
KITSHOP_PASSWORD=
